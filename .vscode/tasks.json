{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm: install",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "npm: compile",
            "dependsOn": "npm: install",
            "type": "shell",
            "command": "npm run compile",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build Tolza VSIX",
            "type": "shell",
            "command": "npx vsce package",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "npm: compile",
            "problemMatcher": []
        }
    ]
}