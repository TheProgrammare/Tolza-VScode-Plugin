{
  "name": "tolza-vscode-plugin",
  "displayName": "Tolza VS Code plugin",
  "description": "The official Tolza programming language plugin !",
  "author": "Programmare",
  "publisher": "",
  "version": "1.0.0",
  "repository": "https://github.com/TheProgrammare/Tolza-VScode-Plugin",
  "icon": "icons/tolza-logo-512.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tolza",
        "aliases": [
          "Tolza",
          "tolza",
          "tlz"
        ],
        "extensions": [
          ".tlz"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tlz.svg",
          "dark": "./icons/tlz.svg"
        }
      }
    ],
    "commands": [
      {
        "command": "tolza.build",
        "title": "Build",
        "icon": "$(build)"
      },
      {
        "command": "tolza.run",
        "title": "Run",
        "icon": "$(play)"
      },
      {
        "command": "tolza.build_check",
        "title": "Check",
        "icon": "$(remote)"
      },
      {
        "command": "tolza.audit",
        "title": "Audit",
        "icon": "$(list-tree)"
      },
      {
        "command": "tolza.check",
        "title": "Check .toml file",
        "icon": "$(unverified)"
      },
      {
        "command": "tolza.sync",
        "title": "Sync module tree with files",
        "icon": "$(file-submodule)"
      },
      {
        "command": "tolza.new.workspace",
        "title": "New Workspace",
        "icon": "$(project)"
      },
      {
        "command": "tolza.new.profile",
        "title": "New Profile",
        "icon": "$(note)"
      },
      {
        "command": "tolza.new.manifest",
        "title": "New Manifest",
        "icon": "$(file-text)"
      }
    ],
    "submenus": [
      {
        "id": "tolza.workspaceMenu",
        "label": "Tolza"
      },
      {
        "id": "tolza.projectMenu",
        "label": "Tolza"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "tolza.workspaceMenu",
          "when": "explorerResourceIsFolder"
        },
        {
          "submenu": "tolza.projectMenu",
          "when": "resourceExtname == .toml"
        }
      ],
      "tolza.workspaceMenu": [
        {
          "command": "tolza.new.workspace",
          "group": "new"
        },
        {
          "command": "tolza.new.profile",
          "group": "new"
        },
        {
          "command": "tolza.new.manifest",
          "group": "new"
        },
        {
          "command": "tolza.audit",
          "group": "workspace"
        }
      ],
      "tolza.projectMenu": [
        {
          "command": "tolza.check",
          "group": "workspace"
        },
        {
          "command": "tolza.build",
          "group": "compiler"
        },
        {
          "command": "tolza.run",
          "group": "compiler"
        }
      ]
    },
    "grammars": [
      {
        "language": "tolza",
        "scopeName": "source.tolza",
        "path": "./syntaxes/tolza.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tolza",
        "path": "./snippets/tolza-snippets.json"
      }
    ],
    "configuration": [
      {
        "title": "Tolza",
        "properties": {
          "tolza.toolchain": {
            "type": "string",
            "default": "tolza",
            "description": "Path to the Tolza toolchain binary. e.g. /usr/bin/tolza"
          },
          "tolza.compiler": {
            "type": "string",
            "default": "tolza-compiler",
            "description": "path to the Tolza compiler binary. e.g. /usr/bin/tolza-compiler"
          },
          "tolza.command_check_args": {
            "type": "string",
            "description": "Arguments for the check command"
          },
          "tolza.command_build_args": {
            "type": "string",
            "description": "Arguments for the build command"
          }
        }
      }
    ]
  },
  "activationEvents": [
    "workspaceContains:tolza.toml",
    "workspaceContains:*.tlz",
    "workspaceContains:**/*.tlz"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc",
    "vscode:prepublish": "npm run compile"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@types/which": "^3.0.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "which": "^6.0.1"
  }
}