{
  "name": "tolza-vscode-plugin",
  "displayName": "Tolza VS Code plugin",
  "description": "The official Tolza programming language plugin !",
  "author": "Programmare",
  "publisher": "",
  "version": "1.0.0",
  "repository": "https://github.com/TheProgrammare/Tolza-VScode-Plugin",
  "icon": "icons/tolza-logo-512.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tolza",
        "aliases": [
          "Tolza",
          "tolza"
        ],
        "extensions": [
          ".tlz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "tolza.build",
        "title": "Tolza: Build"
      },
      {
        "command": "tolza.run",
        "title": "Tolza: Run"
      },
      {
        "command": "tolza.check",
        "title": "Tolza: Check"
      }
    ],
    "grammars": [
      {
        "language": "tolza",
        "scopeName": "source.tolza",
        "path": "./syntaxes/tolza.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tolza",
        "path": "./snippets/tolza-snippets.json"
      }
    ],
    "iconThemes": [
      {
        "id": "tolza-theme-icons",
        "label": "Tolza theme icons",
        "path": "./icons/fileicons.json"
      }
    ],
    "configuration": [
      {
        "title": "Tolza",
        "properties": {
          "tolza.toolchain": {
            "type": "string",
            "default": "tolza",
            "description": "Path to the Tolza toolchain binary. e.g. /usr/bin/tolza"
          },
          "tolza.compiler": {
            "type": "string",
            "default": "tolza-compiler",
            "description": "path to the Tolza compiler binary. e.g. /usr/bin/tolza-compiler"
          },
          "tolza.command_check_args": {
            "type": "string",
            "default": "--diagnostic-format json",
            "description": "Arguments for the check command"
          },
          "tolza.command_build_args": {
            "type": "string",
            "default": "--diagnostic-format json",
            "description": "Arguments for the build command"
          }
        }
      }
    ]
  },
  "activationEvents": [
    "onLanguage:tolza",
    "workspaceContains:tolza.toml",
    "workspaceContains:*.tlz",
    "workspaceContains:**/*.tlz",
    "onCommand:tolza.build",
    "onCommand:tolza.run",
    "onCommand:tolza.check"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc",
    "vscode:prepublish": "npm run compile"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@types/which": "^3.0.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "which": "^6.0.1"
  }
}