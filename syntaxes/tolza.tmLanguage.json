{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tolza",
  "scopeName": "source.tolza",
  "patterns": [
    {
      "include": "#global"
    }
  ],
  "repository": {
    "global": {
      "name": "meta.global.tolza",
      "patterns": [
        {
          "include": "#metacode"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#reserved"
        },
        {
          "include": "#literals"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#statements"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#expressions"
        },
        {
          "include": "#memory_operators"
        },
        {
          "include": "#types"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "metacode": {
      "name": "keyword.control.directive.tolza",
      "begin": "^\\s*#",
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#reserved"
        },
        {
          "include": "#literals"
        },
        {
          "include": "#statements"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#memory_operators"
        },
        {
          "include": "#type_primitive"
        }
      ]
    },
    "comment": {
      "name": "meta.comment.tolza",
      "patterns": [
        {
          "name": "comment.line.double-slash.tolza",
          "match": "//.*$"
        },
        {
          "include": "#block_comment"
        }
      ]
    },
    "block_comment": {
      "name": "comment.block.tolza",
      "begin": "/\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.tolza"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.tolza"
        }
      },
      "patterns": [
        {
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.tolza"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.tolza"
            }
          },
          "patterns": [
            {
              "include": "#block_comment"
            }
          ]
        }
      ]
    },
    "declarations": {
      "name": "meta.declaration.tolza",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#mod_declaration"
        },
        {
          "include": "#export_declaration"
        },
        {
          "include": "#extern_declaration"
        },
        {
          "include": "#import_declaration"
        },
        {
          "include": "#function_declaration"
        },
        {
          "include": "#function_return"
        },
        {
          "include": "#function_message"
        },
        {
          "include": "#enum_declaration"
        },
        {
          "include": "#flag_declaration"
        },
        {
          "include": "#union_declaration"
        },
        {
          "include": "#form_declaration"
        },
        {
          "include": "#form_facet_use"
        },
        {
          "include": "#extension_fn"
        },
        {
          "include": "#extension_cast"
        },
        {
          "include": "#extension_operation"
        },
        {
          "include": "#facet_declaration"
        },
        {
          "include": "#view_declaration"
        },
        {
          "include": "#rule_declaration"
        },
        {
          "include": "#typealias_declaration"
        },
        {
          "include": "#variable_declaration"
        },
        {
          "include": "#variable_declaration_constant"
        },
        {
          "include": "#asm_declaration"
        },
        {
          "include": "#llvm_declaration"
        }
      ]
    },
    "mod_declaration": {
      "name": "meta.module.tolza",
      "match": "\\b(mod)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.module.tolza"
        },
        "2": {
          "name": "entity.name.module.tolza"
        }
      }
    },
    "export_declaration": {
      "name": "meta.export.tolza",
      "match": "\\b(export)\\b\\s*\\{",
      "captures": {
        "0": {
          "name": "keyword.declaration.export.tolza"
        }
      }
    },
    "extern_declaration": {
      "name": "meta.extern.tolza",
      "match": "\\b(extern)\\s*\"([^\"]*)\"\\s*\\{",
      "captures": {
        "1": {
          "name": "keyword.declaration.extern.tolza"
        },
        "2": {
          "name": "string.quoted.double.tolza"
        }
      }
    },
    "import_declaration": {
      "name": "meta.import.tolza",
      "match": "\\b(import)\\b\\s+((?:bind::|scr::|pkg::|std::|vendor::))\\s*([a-zA-Z_][a-zA-Z0-9_]*\\b(?:::\\s*[a-zA-Z_][a-zA-Z0-9_]*))\\b",
      "captures": {
        "1": {
          "name": "keyword.control.import.tolza"
        },
        "2": {
          "name": "keyword.control.mode.tolza"
        },
        "3": {
          "name": "entity.name.module.tolza"
        }
      }
    },
    "function_declaration": {
      "name": "meta.function.tolza",
      "begin": "\\bfn\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "0": {
          "name": "keyword.declaration.function.tolza"
        },
        "1": {
          "name": "entity.name.function.tolza"
        }
      },
      "end": "(?<=\\{|;)",
      "patterns": [
        {
          "name": "meta.parameters",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameter_declaration"
            }
          ]
        },
        {
          "name": "meta.return",
          "begin": "\\-\\>",
          "end": "(\\{|\\-\\>|;)",
          "patterns": [
            {
              "include": "#types"
            },
            {
              "include": "#type_identifier"
            },
            {
              "include": "#type_safe"
            }
          ]
        }
      ]
    },
    "enum_declaration": {
      "name": "meta.enum.tolza",
      "begin": "\\b(enum)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.enum.tolza"
        },
        "2": {
          "name": "entity.name.type.enum.tolza"
        }
      },
      "end": "(\\}|;)",
      "patterns": [
        {
          "name": "constant.other.enum.tolza",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
        },
        {
          "include": "#type_tuple"
        },
        {
          "name": "punctuation.separator.enum.tolza",
          "match": ","
        }
      ]
    },
    "flag_declaration": {
      "name": "meta.flag.tolza",
      "begin": "\\b(flag)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.flag.tolza"
        },
        "2": {
          "name": "entity.name.type.flag.tolza"
        }
      },
      "end": "(\\}|;)",
      "patterns": [
        {
          "name": "constant.other.flag.tolza",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
        },
        {
          "name": "punctuation.separator.flag.tolza",
          "match": ","
        }
      ]
    },
    "union_declaration": {
      "name": "meta.union.tolza",
      "begin": "\\b(union)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.union.tolza"
        },
        "2": {
          "name": "entity.name.type.union.tolza"
        }
      },
      "end": "(?<=\\}|;)",
      "patterns": [
        {
          "include": "#types"
        },
        {
          "name": "constant.other.union.tolza",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
        },
        {
          "name": "punctuation.separator.union.tolza",
          "match": ","
        }
      ]
    },
    "form_declaration": {
      "name": "meta.form.tolza",
      "match": "\\b(form)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.form.tolza"
        },
        "2": {
          "name": "entity.name.type.form.tolza"
        }
      }
    },
    "facet_declaration": {
      "name": "meta.facet.tolza",
      "match": "\\b(facet)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.facet.tolza"
        },
        "2": {
          "name": "entity.name.type.facet.tolza"
        }
      }
    },
    "view_declaration": {
      "name": "meta.view.tolza",
      "match": "\\b(view)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.view.tolza"
        },
        "2": {
          "name": "entity.name.type.view.tolza"
        }
      }
    },
    "rule_declaration": {
      "name": "meta.rule.tolza",
      "begin": "\\b(rule)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.rule.tolza"
        },
        "2": {
          "name": "entity.name.function.tolza"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.tolza"
        }
      },
      "patterns": [
        {
          "include": "#parameter_declaration"
        }
      ]
    },
    "form_facet_use": {
      "name": "meta.form.use.tolza",
      "match": "\\b(use)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.facet.tolza"
        },
        "2": {
          "name": "entity.name.type.facet.tolza"
        }
      }
    },
    "extension_fn": {
      "name": "meta.extension.fn.tolza",
      "begin": "\\b(extend)\\s+",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.extension.tolza"
        }
      },
      "end": "fn",
      "endCaptures": {
        "0": {
          "name": "keyword.declaration.function.tolza"
        }
      },
      "patterns": [
        {
          "include": "#types"
        }
      ]
    },
    "extension_cast": {
      "name": "meta.extension.cast.tolza",
      "begin": "\\b(extend)\\+",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.cast.tolza"
        }
      },
      "end": "as",
      "endCaptures": {
        "0": {
          "name": "keyword.operator.cast.as.tolza"
        }
      },
      "patterns": [
        {
          "include": "#types"
        }
      ]
    },
    "extension_operation": {
      "name": "meta.extension.op.tolza",
      "begin": "\\b(extend)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.operation.tolza"
        }
      },
      "end": "op",
      "endCaptures": {
        "0": {
          "name": "keyword.control.operator.tolza"
        }
      },
      "patterns": [
        {
          "include": "#operators"
        },
        {
          "include": "#types"
        }
      ]
    },
    "parameter_declaration": {
      "name": "meta.declaration.parameter.tolza",
      "begin": "(ref|mut|move|copy|addr)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.pass-mode.tolza"
        },
        "2": {
          "name": "variable.parameter.tolza"
        }
      },
      "end": "(?=\\s*[),])",
      "patterns": [
        {
          "include": "#type_identifier"
        },
        {
          "include": "#types"
        },
        {
          "name": "meta.variadic.tolza",
          "match": "\\.\\.\\."
        },
        {
          "begin": "\\s*=\\s*",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.assignment.tolza"
            }
          },
          "end": "(?=\\s*[),])",
          "patterns": [
            {
              "include": "#expressions"
            }
          ]
        }
      ]
    },
    "typealias_declaration": {
      "name": "meta.typealias.tolza",
      "match": "\\b(type)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "keyword.declaration.type.tolza"
        },
        "2": {
          "name": "entity.name.type.tolza"
        }
      }
    },
    "variable_declaration": {
      "name": "meta.variable.tolza",
      "match": "\\b(var|mut)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "keyword.declaration.variable.tolza"
        },
        "2": {
          "name": "variable.other.readwrite.tolza"
        }
      }
    },
    "variable_declaration_constant": {
      "name": "meta.variable.tolza",
      "match": "\\b(let|const|ref)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "keyword.declaration.variable.tolza"
        },
        "2": {
          "name": "variable.other.constant.tolza"
        }
      }
    },
    "goto_label": {
      "name": "meta.goto.label.tolza",
      "match": "\\b(label)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b\\s*\\{",
      "captures": {
        "1": {
          "name": "keyword.declaration.label.tolza"
        },
        "2": {
          "name": "entity.name.label.tolza"
        }
      }
    },
    "goto": {
      "name": "meta.goto.tolza",
      "match": "\\b(goto)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "keyword.declaration.goto.tolza"
        },
        "2": {
          "name": "entity.name.label.tolza"
        }
      }
    },
    "asm_declaration": {
      "begin": "\\basm\\b\\s*\\{",
      "beginCaptures": {
        "0": {
          "name": "keyword.declaration.asm.tolza"
        }
      },
      "end": "\\}",
      "name": "source.embedded.asm.tolza",
      "patterns": [
        {
          "include": "#assembly"
        }
      ]
    },
    "llvm_declaration": {
      "begin": "\\bllvm\\b\\s*\\{",
      "beginCaptures": {
        "0": {
          "name": "keyword.declaration.llvm.tolza"
        }
      },
      "end": "\\}",
      "name": "source.embedded.llvm.tolza",
      "patterns": [
        {
          "include": "#llvmir"
        }
      ]
    },
    "assembly": {
      "name": "meta.asm.tolza",
      "patterns": [
        {
          "name": "comment.line.semicolon.asm",
          "match": ";.*$"
        },
        {
          "name": "entity.name.label.asm",
          "match": "^[a-zA-Z_][a-zA-Z0-9_]*:"
        },
        {
          "name": "keyword.instruction.asm",
          "match": "\\b(mov|add|sub|mul|div|jmp|call|ret|push|pop|cmp|jne|je|jg|jl|inc|dec|and|or|xor|nop|lea)\\b"
        },
        {
          "name": "variable.register.asm",
          "match": "\\b(eax|ebx|ecx|edx|esi|edi|esp|ebp|ax|bx|cx|dx|si|di|sp|bp|al|ah|bl|bh|cl|ch|dl|dh)\\b"
        },
        {
          "name": "constant.numeric.asm",
          "match": "0x[0-9A-Fa-f]+|\\b\\d+\\b"
        },
        {
          "name": "string.quoted.double.asm",
          "match": "\"[^\"]*\""
        },
        {
          "name": "variable.other.global.asm",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "storage.modifier.asm",
          "match": "\\b(byte|word|dword|qword|ptr)\\b"
        }
      ]
    },
    "llvmir": {
      "name": "meta.llvmir.tolza",
      "patterns": [
        {
          "name": "comment.line.semicolon.ll",
          "match": ";.*$"
        },
        {
          "name": "entity.name.label.ll",
          "match": "^(\\s*)([a-zA-Z_][a-zA-Z0-9_]*:)"
        },
        {
          "name": "variable.other.register.ll",
          "match": "%[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "keyword.instruction.ll",
          "match": "\\b(add|sub|mul|sdiv|udiv|fadd|fsub|fmul|fdiv|load|store|call|ret|br|icmp|fcmp|alloca|getelementptr|phi|select|shufflevector|extractelement|insertelement|atomicrmw)\\b"
        },
        {
          "name": "storage.type.ll",
          "match": "\\b(i\\d+|float|double|void|ptr)\\b"
        },
        {
          "name": "constant.numeric.ll",
          "match": "0x[0-9A-Fa-f]+|\\b\\d+\\b"
        },
        {
          "name": "string.quoted.double.ll",
          "match": "\"[^\"]*\""
        },
        {
          "name": "variable.other.global.ll",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "statements": {
      "name": "meta.statement.tolza",
      "patterns": [
        {
          "name": "keyword.control.tolza",
          "match": "\\b(if|elif|else|while|for|do|match|loop)\\b"
        },
        {
          "name": "keyword.control.flow.tolza",
          "match": "\\b(return|break|continue|end)\\b"
        }
      ]
    },
    "memory_operators": {
      "name": "meta.operator.memory.tolza",
      "patterns": [
        {
          "name": "keyword.operator.new.tolza",
          "match": "\\bnew\\b"
        },
        {
          "name": "keyword.operator.del.tolza",
          "match": "\\bdel\\b"
        },
        {
          "name": "keyword.operator.drop.tolza",
          "match": "\\bdrop\\b"
        },
        {
          "name": "assi",
          "match": "\\bnew\\b"
        },
        {
          "name": "keyword.operator.pointer.at.tolza",
          "match": "\\'at"
        },
        {
          "name": "keyword.operator.pointer.offset.tolza",
          "match": "\\'offset"
        },
        {
          "name": "keyword.operator.pointer.reference.tolza",
          "match": "\\bref\\'"
        },
        {
          "name": "keyword.operator.pointer.mutation.tolza",
          "match": "\\bmut\\'"
        },
        {
          "name": "keyword.operator.pointer.value.tolza",
          "match": "\\bval\\'"
        },
        {
          "name": "keyword.operator.pointer.adress.tolza",
          "match": "\\baddr\\'"
        }
      ]
    },
    "expressions": {
      "name": "meta.expression.tolza",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#reserved"
        },
        {
          "include": "#field_init"
        },
        {
          "include": "#function_call"
        },
        {
          "include": "#rule_call"
        },
        {
          "include": "#types"
        },
        {
          "include": "#identifiers"
        },
        {
          "include": "#literals"
        }
      ]
    },
    "field_init": {
      "name": "meta.field.init.tolza",
      "match": "\\b\\.([A-Za-z_][A-Za-z0-9_]*)\\s*\\=",
      "captures": {
        "1": {
          "name": "variable.other.member.tolza"
        }
      }
    },
    "function_call": {
      "name": "meta.call.tolza",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?:\\(|\\||\\<-\\|)",
      "captures": {
        "1": {
          "name": "entity.name.function.tolza"
        }
      }
    },
    "generic_arguments": {
      "name": "meta.generic.arguments.tolza",
      "begin": "<",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.generic.begin.tolza"
        }
      },
      "end": ">",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.generic.end.tolza"
        }
      },
      "patterns": [
        {
          "include": "#types"
        },
        {
          "name": "punctuation.separator.generic.tolza",
          "match": ","
        }
      ]
    },
    "rule_call": {
      "name": "meta.call.rule.tolza",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*-\\>\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
      "captures": {
        "1": {
          "name": "entity.name.form.tolza"
        },
        "2": {
          "name": "entity.name.rule.tolza"
        }
      }
    },
    "identifiers": {
      "name": "meta.identifier.tolza",
      "patterns": [
        {
          "name": "variable.language.scope.tolza",
          "match": "\\b(self|super)?::"
        },
        {
          "include": "#qualified_identifier"
        },
        {
          "include": "#identifier"
        }
      ]
    },
    "identifier": {
      "name": "variable.other.tolza",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    },
    "qualified_identifier": {
      "name": "meta.identifier.qualified.tolza",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.tolza"
        },
        "2": {
          "name": "punctuation.separator.namespace.tolza"
        }
      }
    },
    "types": {
      "name": "meta.type.tolza",
      "patterns": [
        {
          "include": "#type_modifier"
        },
        {
          "include": "#type_primitive"
        },
        {
          "include": "#type_generic"
        },
        {
